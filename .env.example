# ---------------------------------------------------------------------------
# AURIX environment
# Copy to `.env.local` and fill in. `.env.local` is git-ignored — never commit it.
# ---------------------------------------------------------------------------

# Supabase project URL. Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. Settings -> API Keys -> Publishable key.
# Safe to expose in the browser: it is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Canonical site origin, used for metadata/OpenGraph/sitemap.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefixed with NEXT_PUBLIC_, never imported in client code.
# Not required to run the app; used only by local tooling.
# ---------------------------------------------------------------------------

# Direct Postgres connection, used by `supabase db push` and psql.
# Settings -> Database -> Connection string.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
